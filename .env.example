# Copy to .env.local for local development; add the same values in Vercel.
# Choose a unique password of at least 12 characters.
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
# Fine-grained GitHub token, restricted to this repository, Contents: Read and write.
GITHUB_TOKEN=
GITHUB_REPOSITORY=your-name/your-repository
GITHUB_BRANCH=main
# Independent data branch; its Vercel deployments must stay disabled.
COMMENTS_BRANCH=comments-data
# Generate another independent 32-byte base64url key and keep a backup.
# Do not reuse ADMIN_SESSION_SECRET or replace this key after storing comments.
COMMENT_ENCRYPTION_KEY=
